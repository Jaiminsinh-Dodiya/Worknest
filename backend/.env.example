# WorkNest Backend Environment Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Connection String via Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worknest?schema=public"

# JWT Secrets
JWT_SECRET="worknest_jwt_secret_dev_key_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="worknest_jwt_refresh_dev_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CLIENT_URL="http://localhost:5173"

# NVIDIA AI Gateway
# Get your key at https://integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_AI_MODEL=meta/llama-3.1-8b-instruct
